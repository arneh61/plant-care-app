# JWT Secret for authentication (REQUIRED - change in production!)
JWT_SECRET=change_this_secret_in_production_use_long_random_string

# Plant Database APIs (Optional but recommended for better search results)
# Get Perenual API key from: https://perenual.com/docs/api
PERENUAL_API_KEY=your_perenual_api_key_here

# Get Trefle API key from: https://trefle.io/
TREFLE_API_KEY=your_trefle_api_key_here

# Claude AI API (Optional - for Plant Doctor feature)
# Get API key from: https://console.anthropic.com/
CLAUDE_API_KEY=your_claude_api_key_here

# Node Environment
NODE_ENV=production
